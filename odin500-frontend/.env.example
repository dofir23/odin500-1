# Odin500 frontend — environment (copy to `.env` for local builds)

# API
VITE_API_MODE=prod
VITE_API_ORIGIN_PROD=https://odin500-1-production.up.railway.app
VITE_API_ORIGIN_DEV=http://localhost:5000

# SEO / Google indexing — REQUIRED for production builds that should be crawled
# When true, ProtectedRoute does not redirect Googlebot to /login
VITE_AUTH_DISABLED=true

# Google Search Console HTML tag verification (optional)
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-token

# Sitemap build (npm run sitemap / npm run build)
# SITEMAP_API_ORIGIN=https://odin500-1-production.up.railway.app
# SITEMAP_TICKERS=AAPL,MSFT,NVDA

# SSR server (production Express)
# SSR_API_ORIGIN=https://odin500-1-production.up.railway.app
# PORT=3000
