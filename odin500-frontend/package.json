{
  "name": "trading-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender-meta.mjs",
    "build:app": "vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "start:ssr": "npm run build && node server/server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "compression": "^1.8.0",
    "d3-hierarchy": "^3.1.2",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "lightweight-charts": "4.2.3",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.14.0",
    "sirv": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.2.2",
    "vite": "^6.0.3"
  }
}
